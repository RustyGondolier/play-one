# Copia este archivo como .env en la raíz del proyecto y completa los valores

# URL de conexión a Neon (PostgreSQL). La obtienes desde el dashboard de Neon:
# https://console.neon.tech -> tu proyecto -> "Pooled connection" (o Direct)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secreto para firmar los tokens JWT (cambia esto en producción).
# Obligatorio: sin él, todas las rutas de negocio responden 401.
JWT_SECRET=cambia-este-secreto-en-produccion

# Puerto del servidor API (solo en local). En Render NO se define:
# la plataforma inyecta el suyo y Express lo lee con process.env.PORT.
PORT=3001
